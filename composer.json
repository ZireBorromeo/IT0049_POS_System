{
  "name": "student/it0049-pos-system",
  "description": "IT0049 Midterm Project - Complete Point-of-Sale System built with CodeIgniter 4",
  "type": "project",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@php spark cache:clear"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
